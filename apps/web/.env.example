# Sao chép thành .env.local. KHÔNG commit.
# Không biến nào có tiền tố NEXT_PUBLIC_ => không lọt vào bundle client.

# Chuỗi Postgres CHUẨN — chạy với Supabase, Neon, Railway hay Postgres tự dựng.
# Nếu nhà cung cấp có pooler (Supavisor/PgBouncer), dùng cổng pooler cho serverless.
DATABASE_URL=postgres://user:pass@host:5432/db

# Google Cloud Console -> Credentials -> OAuth client (Web application)
# Authorized redirect URIs: <origin>/api/v1/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Để trống thì suy ra từ request. Đặt khi chạy sau proxy có host khác.
APP_ORIGIN=

# ID extension được phép gọi API (CORS). Nhiều id thì phân tách bằng dấu phẩy.
ALLOWED_EXTENSION_IDS=
